# ── ATMcp configuration (copy to .env and adjust) ──────────────────────────
# Admin token gates team creation / ops endpoints (POST /api/teams, etc.).
ATMCP_ADMIN_TOKEN=change-me-admin-token

# Storage / infra
ATMCP_SQLITE_PATH=./data/atmcp.db
ATMCP_REDIS_URL=redis://localhost:6379/0

# Public URL advertised to agents (used in README / dashboard hints).
# Also drives MCP DNS-rebinding allowed Host/Origin; set to the URL agents use
# (e.g. http://192.168.2.7:18000 on LAN).
ATMCP_PUBLIC_URL=http://localhost:8000

# MCP streamable-HTTP transport security (optional overrides)
# ATMCP_MCP_DNS_REBINDING=1
# ATMCP_MCP_ALLOWED_HOSTS=192.168.2.7:18000,192.168.2.7:*
# ATMCP_MCP_ALLOWED_ORIGINS=http://192.168.2.7:18000

# Presence / liveness knobs (seconds)
ATMCP_HEARTBEAT_TTL_S=30          # heartbeat key TTL; missing => offline
ATMCP_HEARTBEAT_INTERVAL_S=10     # advised cadence returned to agents
ATMCP_PRESENCE_HEALTHY_S=15       # heartbeat age < this => healthy (green)
ATMCP_PRESENCE_DEGRADED_S=30      # age < this => degraded (amber); else offline

# Task coordination knobs
ATMCP_LEASE_TTL_S=90              # default task lease; per-task override allowed
ATMCP_REAPER_INTERVAL_S=5         # how often expired leases are re-queued
ATMCP_TASK_MAX_ATTEMPTS=5         # attempts before a task is dead-lettered

# Misc
ATMCP_IDEM_TTL_S=600              # idempotency record retention
ATMCP_STREAM_MAXLEN=1000          # Redis Stream hot-window size for catch-up
ATMCP_DASHBOARD_AUTH=0            # 0 = open dashboard; 1 = require dashboard token
